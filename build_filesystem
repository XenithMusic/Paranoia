#!/bin/bash

# guarantee all of my loopbacks are unmounted (these will likely fail)
sudo umount ./fsconst/primary
sudo umount ./fsconst/esp
sudo losetup -D

set -e

# create disk
echo "[build_filesystem_v2] Creating image."
dd if=/dev/zero of=filesystem.img bs=1M count=256 conv=sparse
# parted filesystem.img mklabel msdos # mbr table
parted filesystem.img mklabel gpt # gpt table

# parted filesystem.img mkpart primary ext2 1MiB 100%
# parted filesystem.img set 1 boot on

parted filesystem.img mkpart ESP fat32 1MiB 65MiB
parted filesystem.img set 1 esp on
parted filesystem.img mkpart primary ext2 65MiB 100%

mkdir -p ./fsconst/primary
mkdir -p ./fsconst/esp

sudo losetup -Pf filesystem.img

# format
echo "[build_filesystem_v2] Formatting image."
sudo mkfs.fat -F 32 /dev/loop0p1
sudo mkfs.ext2 -I 128 -O ^has_journal,^ext_attr,^resize_inode,^dir_index,^filetype,^sparse_super /dev/loop0p2
sudo tune2fs -e panic /dev/loop0p2 # set errorhandling method to panic (0x3)
sudo tune2fs -L "primary" /dev/loop0p2
sudo tune2fs -c 5 /dev/loop0p2
sudo tune2fs -C -1 /dev/loop0p2

# build filesystem
echo "[build_filesystem_v2] Building filesystem."
sudo mount /dev/loop0p1 ./fsconst/esp
sudo mount /dev/loop0p2 ./fsconst/primary
sudo cp -r ./iso/* ./fsconst/primary
sudo cp -r ./filesystem/* ./fsconst/primary

# install grub
echo "[build_filesystem_v2] Installing grub."
sudo grub-install --target=x86_64-efi --boot-directory=./fsconst/primary/boot --efi-directory=./fsconst/esp --bootloader-id=GRUB --removable --no-nvram

# unmount
echo "[build_filesystem_v2] Done! Cleaning."
sync
sudo umount ./fsconst/esp
sudo umount ./fsconst/primary
sudo losetup -d /dev/loop0

echo "[build_filesystem_v2] Cleaned up!"

